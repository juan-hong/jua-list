{
  "name": "jua-list",
  "version": "0.2.0",
  "description": "Desktop todo widget for Windows that Claude can read, edit and work on. Tag a task @claude, press ▶ and Claude Code does it, then waits for your review.",
  "author": {
    "name": "juan-hong",
    "url": "https://github.com/juan-hong"
  },
  "homepage": "https://github.com/juan-hong/jua-list",
  "repository": "https://github.com/juan-hong/jua-list",
  "license": "MIT",
  "keywords": ["todo", "widget", "desktop", "windows", "task", "markdown", "mcp", "agent"],
  "icon": ".claude-plugin/icon.png",
  "mcpServers": {
    "jua-list": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/jua/jua_mcp.py"]
    }
  }
}
